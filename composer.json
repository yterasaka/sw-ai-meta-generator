{
  "name": "yukit/ai-meta-generator",
  "description": "A Shopware 6 plugin for generating metadata using AI",
  "type": "shopware-platform-plugin",
  "version": "1.1.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Yuki Terasaka"
    }
  ],
  "require": {
    "shopware/core": "~6.7.0"
  },
  "extra": {
